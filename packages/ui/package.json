{
  "name": "@crumza/ui",
  "version": "0.1.0-alpha.0",
  "description": "Tailwind-first React components with solid, frosted and liquid materials.",
  "keywords": [
    "design-system",
    "react",
    "tailwind",
    "glass",
    "liquid-glass",
    "bunmaska"
  ],
  "license": "MIT",
  "author": "Indrajeet O.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crumza/crumza.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "import": "./dist/web/index.js"
    },
    "./liquid": {
      "types": "./dist/liquid/index.d.ts",
      "import": "./dist/liquid/index.js"
    },
    "./styles.css": "./src/web/styles/crumza.css",
    "./liquid.css": "./src/liquid/styles/liquid.css"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "THIRD-PARTY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run tokens && bun scripts/build.ts && tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "tokens": "bun scripts/build-tokens.ts",
    "tokens:check": "bun scripts/build-tokens.ts --check",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "type-check": "tsc -p tsconfig.core.json && tsc -p tsconfig.web.json && tsc -p tsconfig.tools.json",
    "test": "bun test tests",
    "validate": "bun run tokens:check && bun run format:check && bun run lint && bun run type-check && bun run test && bun run e2e",
    "dev": "bun --cwd ../../apps/playground dev",
    "shot": "bun scripts/shot.ts",
    "e2e": "bun test e2e --timeout 60000"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/bun": "1.4.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "playwright": "1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "6.0.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
